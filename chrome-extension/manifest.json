{
  "manifest_version": 3,
  "name": "WingWatch",
  "version": "1.0",
  "permissions": ["notifications", "alarms"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}